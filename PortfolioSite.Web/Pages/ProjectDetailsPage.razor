@page "/projects/{Slug}"
@using PortfolioSite.Core
@using PortfolioSite.Web.Data
@inject IProjectsClient Client

@if (_failed)
{
    <p>Could not load projects</p>
}
else if (_notFound)
{
    <p>Project not found</p>
}
else if (_project is null)
{
    <p>Loading…</p>
}
else
{
    <PageTitle>@_project.Title</PageTitle>
    <h1>@_project.Title</h1>
    <img src="@_project.ImageOrPlaceholder" alt="@_project.Title" />
    <p>@_project.Description</p>
    <h2>What I learned</h2>
    <p>@_project.Learned</p>
    <p>@string.Join(", ", _project.Tech)</p>
    <a class="main-link" href="@_project.RepoUrl">Repo on GitHub</a>
    @if (_project.HasDemo)
    {
        <a class="optional-link button" href="@_project.DemoUrl">Live demo</a>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Project? _project;
    private bool _notFound;
    private bool _failed;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var all = await Client.GetProjectsAsync();
            _project = new ProjectService(all).GetProject(Slug);
        }
        catch (KeyNotFoundException)
        {
            _notFound = true;
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }
}
