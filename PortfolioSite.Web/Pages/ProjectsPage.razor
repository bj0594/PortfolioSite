@page "/"
@using PortfolioSite.Core
@using PortfolioSite.Web.Data
@inject IProjectsClient Client

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@if (_failed)
{
    <p>Could not load projects</p>
}

else if (_projects is null)
{
    <p>Loading…</p>
}
else if (_projects.Count == 0)
{
    <p>No projects yet</p>
}
else
{
    @foreach (var project in _projects)
    {
        <article class="project-card">
            <a href="projects/@project.Slug">
                @if (!string.IsNullOrWhiteSpace(project.Image))
                {
                    <img src="@project.Image" alt="@project.Title" />
                }
                <h2>@project.Title</h2>
            </a>
            <p>@project.Summary</p>
            <p>@string.Join(", ", project.Tech)</p>
        </article>
    }
}

@code {
    private IReadOnlyList<Project>? _projects;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Client.GetProjectsAsync();
            _projects = new ProjectService(all).GetProjects();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }
}
